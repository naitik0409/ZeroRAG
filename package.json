{
  "name": "zerorag",
  "version": "0.1.0",
  "description": "Free realtime RAG for Node.js — local embeddings, embedded LanceDB hybrid search, keyless web sources, bring-your-own LLM. $0 forever.",
  "keywords": [
    "rag",
    "retrieval-augmented-generation",
    "ai",
    "embeddings",
    "vector-search",
    "lancedb",
    "local-first",
    "llm"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic.ts",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@langchain/textsplitters": "^1.0.0",
    "@lancedb/lancedb": "^0.41.0",
    "debug": "^4.4.3",
    "fastembed": "^3.0.0"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^24.10.1",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  }
}
