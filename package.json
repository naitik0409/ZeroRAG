{
    "name": "zerorag",
    "version": "0.1.0",
    "description": "Free realtime RAG for Node.js â€” local embeddings, embedded LanceDB hybrid search, keyless web sources, bring-your-own LLM. $0 forever.",
    "keywords": [
        "rag",
        "retrieval-augmented-generation",
        "ai",
        "embeddings",
        "vector-search",
        "lancedb",
        "hybrid-search",
        "realtime",
